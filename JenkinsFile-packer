pipeline {
    agent any
    
    environment {
        AWS_ACCESS_KEY_ID = credentials ('aws-access-key-id')
        AWS_SECRET_ACCESS_KEY = credentials ('aws-secret-access-key')
        AWS_DEFAULT_REGION = 'eu-west-1'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Packer Initialization') {
            steps {
                dir('packer') {
                    sh 'packer init .'
                }
            }
        }
        
        stage('Packer Validate') {
            steps {
                dir('packer') {
                    sh 'packer validate .'
                }
            }
        }
        
        stage('Packer build') {
            steps {
                dir('packer') {
                    sh 'packer build .'
                }
            }
        }
    }
}
